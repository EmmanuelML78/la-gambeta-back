# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_database_password
DATABASE_NAME=el_predio_db

# Better Auth Configuration
# Better Auth maneja las sesiones y tokens automáticamente
# No se necesitan JWT_SECRET ni JWT_REFRESH_SECRET

# Google OAuth Configuration (Better Auth)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_smtp_user
MAIL_PASSWORD=your_smtp_password
MAIL_FROM="El Predio <noreply@elpredio.com>"

# Frontend URLs
FRONTEND_URL=http://localhost:3000

# Security
EMAIL_VERIFICATION_TOKEN_EXPIRY=24h
PASSWORD_RESET_TOKEN_EXPIRY=1h
REQUIRE_EMAIL_VERIFICATION=false

# MercadoPago Payment Configuration
MP_ACCESS_TOKEN=your_mercadopago_access_token
MP_PUBLIC_KEY=your_mercadopago_public_key
MP_CLIENT_ID=your_mercadopago_client_id
MP_CLIENT_SECRET=your_mercadopago_client_secret
MP_ENVIRONMENT=sandbox
BACKEND_URL=http://localhost:3001

# Application
PORT=3001
NODE_ENV=development